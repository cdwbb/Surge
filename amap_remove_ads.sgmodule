#!name=高德地图去广告
#!desc=开屏/首页/搜索/路线/我的/附近/打车去广告。URL 安装，脚本自动缓存。
#!category=GitHubWBB
#!arguments=开屏广告:1,首页推广:1,搜索推广:1,附近推荐:1,路线导航:1,打车推广:1,地点详情:1,我的页面:1,横幅消息:1,工具宫格:1,接口拦截:1,深层清洗:1,详情裁剪:0,输出日志:0
#!arguments-desc=[页面开关] 1 = 开启 / 0 = 关闭\n- 开屏广告：启动图与开屏跳转\n- 首页推广：首页卡片、资源位、图层配置\n- 搜索推广：热词、联想词、结果页推广\n- 附近推荐：附近页推荐流与信息流\n- 路线导航：路线规划、导航中插播、结束页\n- 打车推广：打车资源位、评价气泡、红点角标\n- 地点详情：详情页推广、优惠券、酒店门票页\n- 我的页面：我的页面卡片与活动入口\n- 横幅消息：横幅、AI 推荐、消息盒\n- 工具宫格：工具宫格、转化列表\n\n[高级开关]\n- 接口拦截：纯广告接口在请求阶段直接返回 {}\n- 深层清洗：递归删除广告字段，更彻底也更激进\n- 详情裁剪：详情页按白名单裁剪，激进，默认关\n- 输出日志：在请求备注输出命中详情，排障用
#
# ===== 参数开关 =========================================================
# 在 Surge 的「模块 → 高德地图去广告 → 参数」里直接改，改完自动重载，
# 不用碰代码。参数由 10 条 [Script] 的 argument= 传给脚本，脚本用
# $argument 解析。参数名用中文（Surge 参数界面直接显示成中文条目），
# 占位符必须是三层花括号 {{{参数名}}}，中文名同样有效。
# #!arguments 用「名称:默认值」写法（查询串 a=1&b=2 形式无效）。
# #!arguments-desc 支持 \n 换行与 \n\n 空行，所以这里一项一行写清楚；
# 官方转义表只列了 \" 和 \\，但 \n 在各家模块里通用且实测生效。
# 注意 argument 的值里绝对不能出现逗号 —— [Script] 的参数本身就是逗号
# 分隔，值里有逗号会被截断，所以脚本内部用 & 分隔。
#
# ===== 注释约定 =========================================================
# 全行注释用半角 #（也可用 ; 或 //），本文件只在行首写注释。
# 不写行内注释（配置值后面跟 # 说明）：官方 Profile Format 虽支持行内
# 注释，但要求分隔符前至少有一个空格，[Script] 那几行又被逗号切分，
# 值里多一个 # 就可能被截断，风险大于收益。
# 注意 #! 开头的不是注释而是元数据指令：指令名写错不会报错，只会被当作
# 未知指令忽略，表现为「模块装了但参数全失效」。
#
# ===== 来源与版本 =======================================================
# 自写脚本，规则参考 QingRex/LoonKissSurge 的接口清单、上游 2026-10-20 版
# 字段级规则，以及 RuCu6 amap.js（2024-10-15）的逐接口处理；未复制任何
# 第三方脚本代码。本版唯一网络依赖是 Surge 拉取本仓库的 js 文件（缓存后
# 离线可用）；要求完全离线请改用本地版模块。整理日期 2026-11-05。
# 原模块的 https://kelee.one/.../Amap_remove_ads.js 在源站已返回 404，
# 所以那个模块在任何设备上都不会生效。
#
# ===== 安装 ===========================================================
# 1) 直接 URL 导入本模块，模块开关打开即可：
#      https://raw.githubusercontent.com/cdwbb/Surge/main/amap_remove_ads.sgmodule
#    脚本由模块自动从下面这个地址下载并缓存（默认每 86400 秒检查一次更新）：
#      https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js
# 2) 打开 MITM 主开关并信任 Surge 的 CA 证书。模块只能追加 hostname，
#    不能替你生成/信任证书，也不能打开 MITM 总开关。
# 3) 打开 Rewrite 与 Scripting 功能开关。脚本属于 HTTP 处理管线，
#    这两个开关任一关闭都会静默不执行。
# 4) 改完后重载配置。模块是「补丁」，UI 里看不到原 Profile 的变化，
#    用 surge-cli dump profile effective 或 surge-cli profile diff 看生效结果。
# 5) 脚本拉不到时（raw.githubusercontent.com 被墙/限流）：把 10 条
#    script-path 换成 jsDelivr 镜像，其余不变：
#      https://cdn.jsdelivr.net/gh/cdwbb/Surge@main/js/amap_remove_ads.js
#    或用仓库里同目录的本地版模块 + 手动放置 js 文件。
#
# ===== 符合 Surge 官方约束的做法 ========================================
# * [Script] 每条都显式写 type= 与 script-path=，参数之间不留空格（官方
#   写法为逗号分隔的 key=value），pattern 内不含逗号（值里含逗号会被截断）。
# * http-response 条目必须 requires-body=true，否则脚本拿不到响应体；
#   max-size 显式给 2MB，避免大响应被静默 passthrough 跳过脚本。
# * 10 条脚本名称唯一：[Script] 是键值段，重名会互相覆盖。
# * [Rule] 只用官方允许的内置策略 REJECT；模块里的规则只能插到 Profile
#   规则表最顶部，不能指定位置、也不能用自定义策略组。
#   extended-matching 让域名规则同时匹配 SNI 与 Host。
#   未用 pre-matching：它要求 iOS 5.14.0+ / Mac 5.9.0+，属于提前拒绝的
#   性能优化，去掉后兼容更多版本；需要时可在三条规则末尾自行加上。
# * [MITM] 用 %APPEND% 追加而不是覆盖，不会冲掉主配置里已有的 hostname。
#   MITM 段在模块里只能改 hostname 与 skip-server-cert-verify。
# * [Body Rewrite] / [Map Local] 不在官方 Module 可补丁的 Section 列表里，
#   所以原模块那 5 + 15 条全部改为脚本实现（request 阶段 mock、response
#   阶段字段清洗），本模块只保留 [Rule] + [Script] + [MITM]。
#
# ===== 排障 ===========================================================
# * 脚本完全没跑：先查 MITM 是否覆盖 *.amap.com / CA 是否信任 / Rewrite 与
#   Scripting 开关；再查 auto-quic-block（默认 true，命中 MITM 列表时会自动
#   阻断 QUIC 迫使回退）。仍有漏网可在主配置加 PROTOCOL,QUIC,REJECT。
# * 部分大响应没被清洗：body 超过 max-size 会静默跳过脚本，可调大该值或
#   收窄 pattern；iOS 上若出现 Surge 被系统杀掉，改小 max-size 并给
#   http-response 条目加 engine=webview。
# * 逐组关闭功能：注释掉下面对应的 [Script] 行后重新导入模块，或直接禁用
#   整个模块。模块注入的键值/规则在主配置 UI 里不可调，别在 UI 里找。
# * 看脚本日志：surge-cli script-log <脚本名>；临时给该条目加 debug=true
#   可从磁盘重载脚本并把 console.log 显示在请求备注里，上线前记得移除。
# * 校验配置：surge-cli --check <profile.conf>；脚本顶部 DEBUG / STRICT_CLEAN /
#   POI_DETAIL_STRICT 三个开关可按需切换。
# * 同一请求每阶段最多跑一个脚本，且模块脚本插在 Profile 顶部：若主配置里
#   已有针对同一 URL 的其他脚本，本模块的会优先命中。
# * 若主配置的 MITM hostname 里已有靠前的 -*.amap.com 排除项，按顺序匹配会
#   让追加的 *.amap.com 失效，需在生效配置里确认（MITM 列表按顺序匹配）。
#
# ===== 相比原模块 ======================================================
# 原模块 15 条 [Script] 全指向已失效的远程脚本；且有 4 处重名（"移除路线
# 规划推广"、"移除首页推广" 各两次），实际只生效 13 条。这里全部本地化并
# 去重，另吸收以下字段级规则：
#   * 配置中心 78 个图层键（{status,version,value} 结构置空，不直接删，
#     避免客户端回退到内置默认值）；
#   * 我的页面卡片白名单（含订单卡，不会丢掉订单入口）；
#   * 地点详情 118 个广告模块的删除清单（默认启用，评论/编辑/交通/营业
#     信息等功能模块不删），白名单裁剪降级为 POI_DETAIL_STRICT 可选项；
#   * 搜索结果列表与搜索联想词分开处理（mps/search/sp 是列表，sug 才是
#     联想词，两者结构完全不同）；
#   * 导航插播语音广告 ads-*、公交列表推广、导航前公交卡路里、酒店页
#     优惠入口、步行导航结束页推广卡等。
#   * 附近页只按模块白名单裁剪，不整包返回 {}，避免附近页白屏。
# ======================================================================

[Rule]
DOMAIN,amap-aos-info-nogw.amap.com,REJECT,extended-matching
DOMAIN,free-aos-cdn-image.amap.com,REJECT,extended-matching
DOMAIN-SUFFIX,v.smtcdns.com,REJECT,extended-matching

[Script]
# ---- http-request：纯广告接口不发请求，直接返回 {} ----
高德·拦截开屏与首页资源 = type=http-request,pattern=^https:\/\/m5\.amap\.com\/ws\/(?:valueadded\/alimama\/splash_screen\?|valueadded\/weather\/v2\?|faas\/amap-navigation\/(?:card-service-(?:car-end|route-plan)|main-page-(?:assets|aiqs|location)|ridewalk-end-fc|usr-profile-fc\/homeV2)|aos\/main\/page\/product\/list\?|info_bff\/rankingCard\?|mapapi\/hint_text\/offline_data|message\/notice\/list),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,timeout=10,argument=splash={{{开屏广告}}}&home={{{首页推广}}}&route={{{路线导航}}}&mock={{{接口拦截}}}&log={{{输出日志}}}
高德·拦截搜索推广 = type=http-request,pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/(?:search\/new_hotword\?|search_bff\/hotword\?|search_business\/process\/orderList\?|search_poi\/tips_adv\?|scene\/recommend\?),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,timeout=10,argument=search={{{搜索推广}}}&mock={{{接口拦截}}}&log={{{输出日志}}}
高德·拦截横幅与消息推广 = type=http-request,pattern=^https:\/\/(?:oss\.amap\.com\/ws\/banner\/lists\/\?|ai\.amap\.com\/v1\/ai_rec\/|sns\.amap\.com\/ws\/msgbox\/pull_mp\?),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,timeout=10,argument=banner={{{横幅消息}}}&mock={{{接口拦截}}}&log={{{输出日志}}}
高德·拦截打车推广 = type=http-request,pattern=^https:\/\/m5-zb\.amap\.com\/ws\/(?:ride\/home\/page\/get_commuting_card\?|boss\/(?:order\/car\/(?:feedback\/get_card_questions|feedback\/viptips|king_toolbox_car_bubble|remark\/satisfactionConf|rights_information)|tips\/onscene_visual_optimization|pay\/web\/paySuccess\/info\/request|transportation\/diversion\/resource\/driving)|promotion-web\/resource(?:\/home)?\?),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,timeout=10,argument=taxi={{{打车推广}}}&mock={{{接口拦截}}}&log={{{输出日志}}}

# ---- http-response：业务接口做字段级清洗 ----
高德·首页与配置中心 = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/(?:shield\/frogserver\/aocs\/updatable\/1\?|shield\/dsp\/profile\/index\/nodefaasv3\?|faas\/amap-navigation\/(?:card-service-plan-home|main-page)),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,requires-body=true,max-size=2097152,timeout=10,argument=home={{{首页推广}}}&profile={{{我的页面}}}&route={{{路线导航}}}&strict={{{深层清洗}}}&log={{{输出日志}}}
高德·搜索页与联想词 = type=http-response,pattern=^https:\/\/(?:m5|info)\.amap\.com\/ws\/shield\/(?:search_business\/process\/(?:marketingOperationStructured\?|middleLayer\/sug\?)|search_poi\/(?:homepage\?|mps|sug|search\/sp|tips_operation_location)|search\/(?:poi\/detail|common\/coupon\/info)),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,requires-body=true,max-size=2097152,timeout=10,argument=search={{{搜索推广}}}&poi={{{地点详情}}}&strict={{{深层清洗}}}&poi_strict={{{详情裁剪}}}&log={{{输出日志}}}
高德·路线规划与导航结束页 = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/(?:aos\/perception\/publicTravel\/beforeNavi\?|bus\/plan\/integrate\?|perception\/drive\/(?:routeInfo|routePlan)|c3frontend\/(?:af-(?:hotel|launch)\/page\/main|af-nearby\/nearby)),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,requires-body=true,max-size=2097152,timeout=10,argument=route={{{路线导航}}}&poi={{{地点详情}}}&nearby={{{附近推荐}}}&strict={{{深层清洗}}}&log={{{输出日志}}}
高德·附近页推荐 = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/(?:shield\/search\/nearbyrec_smart\?|smartui\/near_recommend\?),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,requires-body=true,max-size=2097152,timeout=10,argument=nearby={{{附近推荐}}}&strict={{{深层清洗}}}&log={{{输出日志}}}
高德·打车页卡片 = type=http-response,pattern=^https:\/\/m5-zb\.amap\.com\/ws\/(?:sharedtrip\/taxi\/order_detail_car_tips\?|boss\/(?:car\/order\/content_info\?|order_web\/friendly_information)|amap\/hitch\/passenger\/content_info\?),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,requires-body=true,max-size=2097152,timeout=10,argument=taxi={{{打车推广}}}&strict={{{深层清洗}}}&log={{{输出日志}}}
高德·详情页与工具宫格 = type=http-response,pattern=^https:\/\/(?:info|sns|center)\.amap\.com\/ws\/(?:c3frontend\/af-search\/search\?|opc\/tools\/list\?|amc\/server\/conv\/raise_list\?),script-path=https://raw.githubusercontent.com/cdwbb/Surge/main/js/amap_remove_ads.js,requires-body=true,max-size=2097152,timeout=10,argument=search={{{搜索推广}}}&tools={{{工具宫格}}}&strict={{{深层清洗}}}&log={{{输出日志}}}

[MITM]
hostname = %APPEND% *.amap.com
